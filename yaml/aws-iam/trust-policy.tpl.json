{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::${AWS_ACCOUNT_ID}:oidc-provider/${OIDC_HOST_PATH}"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "${OIDC_HOST_PATH}:sub": "system:serviceaccount:${TARGET_NS}:${TARGET_SA}",
          "${OIDC_HOST_PATH}:aud": "sts.amazonaws.com"
        }
      }
    }
  ]
}
