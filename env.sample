# cp env.sample env.local → 値を埋める → source env.local
# env.local は .gitignore 済み。秘密鍵・パスワードは書かない。

# --- ROSA ---
export CLUSTER_NAME=<rosa-cluster-name>
export AWS_REGION=ap-northeast-1

# --- AWS (ESO × Secrets Manager 用) ---
export AWS_ACCOUNT_ID=<12桁>
export AWS_SECRET_NAME=rosa-demo/password
# 以降は docs/01-client-setup.md の手順で算出して追記
# export OIDC_HOST_PATH=<rosa describe cluster の OIDC endpoint から https:// を除いたもの>
# export AWS_SECRET_ARN=<create-secret の ARN>
# export ESO_ROLE_ARN=arn:aws:iam::${AWS_ACCOUNT_ID}:role/rosa-eso-demo

# OCI Vault は OCP 検証と同じ値 (yaml/eso/oci/02-secretstore.yaml に記載済み)。ここでは不要。
export OCI_REGION=ap-tokyo-1   # egress 確認 (01-client-setup.md §0-5) 用
